// ================= WIFI =================
const char* ssid = "IQOO";
const char* password = "123456789";

WebServer server(80);
HardwareSerial& arduinoSerial = Serial2;

// ================= DHT11 + MQ3 =================
#define DHT_PIN 4
#define DHT_TYPE DHT11
#define MQ3_PIN 34

DHT dht(DHT_PIN, DHT_TYPE);

float temperatureC = 0;
float humidity = 0;
int mq3Value = 0;

// ================= ULTRASONIC PINS =================
#define TRIG_FL 12
#define ECHO_FL 13

#define TRIG_FR 18
#define ECHO_FR 19

#define TRIG_BL 23
#define ECHO_BL 25

#define TRIG_BR 14
#define ECHO_BR 15

// ================= IR LINE + DEPTH SAFETY =================
#define IR_LEFT   5
#define IR_RIGHT  26
#define IR_REAR   33

// ================= OBSTACLE SETTINGS =================
// Keep min small to avoid ignoring close obstacles.
// If you get false stops, raise OBSTACLE_MIN to 3 or 5.
#define OBSTACLE_MIN 1
#define OBSTACLE_MAX 30
#define ULTRASONIC_TIMEOUT_US 18000
#define ULTRASONIC_MAX_VALID_CM 300
#define OBSTACLE_CONFIRM_COUNT 2
#define OBSTACLE_CLEAR_COUNT 2
#define DEPTH_LOST_CONFIRM_COUNT 3
#define MOTOR_DRIVER_LINK_TIMEOUT 4000

// ================= TIMING =================
const unsigned long ULTRASONIC_INTERVAL = 80;
const unsigned long IR_INTERVAL = 60;
const unsigned long MQ3_INTERVAL = 250;
const unsigned long DHT_INTERVAL = 2000;
const unsigned long WIFI_CHECK_INTERVAL = 5000;
const unsigned long CLIENT_WATCHDOG_TIMEOUT = 5000;
// ================= STATE =================
float currentAngle = 0;
float currentSpeed = 0;

float distFrontLeft  = -1;
float distFrontRight = -1;
float distBackLeft   = -1;
float distBackRight  = -1;

String movementDirection = "stop";
String currentDriveMode = "Line Following";
String irLineState = "NO_LINE";
String irLineLabel = "NO LINE";
String driveModeSource = "BOOT";

bool emergencyActive = false;
bool obstacleActive = false;
bool rearFloorLost = false;
bool lineDetected = false;
bool motorDriverConnected = false;
bool frontObstacleDetected = false;
bool rearObstacleDetected = false;
bool obstacleStopIssued = false;

int irLeftRaw = HIGH;
int irRightRaw = HIGH;
int irRearRaw = HIGH;
uint8_t obstacleConfirmCounter = 0;
uint8_t obstacleClearCounter = 0;
uint8_t depthLostCounter = 0;
uint8_t depthRestoreCounter = 0;

float closestFrontObstacleCm = -1;
float closestRearObstacleCm = -1;

unsigned long lastUpdate = 0;
unsigned long lastUltrasonicRead = 0;
unsigned long lastIrRead = 0;
unsigned long lastMq3Read = 0;
unsigned long lastDhtRead = 0;
unsigned long lastWifiCheck = 0;
unsigned long lastClientContact = 0;
unsigned long lastLineSeen = 0;
unsigned long lastArduinoPacketAt = 0;

bool clientSessionActive = false;
bool clientWatchdogStopped = false;

String serialBuffer = "";
String lastLineCommand = "stop";
String lastAutoModeReason = "System boot";

// ================= HELPERS =================
String normalizeDirection(String dir) {
  dir.trim();
  dir.toLowerCase();

  if (dir == "backward" || dir == "reverse") return "back";
  if (dir == "stopped") return "stop";

  return dir;
}

void updateDirectionFromCommand(const String& cmd) {
  if (cmd == "CMD:forward") movementDirection = "forward";
  else if (cmd == "CMD:back") movementDirection = "back";
  else if (cmd == "CMD:left") movementDirection = "left";
  else if (cmd == "CMD:right") movementDirection = "right";
  else if (cmd == "CMD:stop" || cmd == "CMD:EMERGENCY_ON") {
    movementDirection = "stop";
    currentSpeed = 0;
  }
}

bool isObstacleDistance(float d) {
  return (d >= OBSTACLE_MIN && d <= OBSTACLE_MAX);
}

float smallestValidDistance(float a, float b) {
  bool aValid = a >= 0;
  bool bValid = b >= 0;

  if (aValid && bValid) return min(a, b);
  if (aValid) return a;
  if (bValid) return b;
  return -1;
}

bool isMotorDriverLinkAlive() {
  return motorDriverConnected &&
         (millis() - lastArduinoPacketAt <= MOTOR_DRIVER_LINK_TIMEOUT);
}

void sendModeToArduino(const String& mode) {
  currentDriveMode = mode;
  arduinoSerial.println("MODE:" + mode);

  Serial.print("-> MODE:");
  Serial.println(mode);
}

void printIRTestStatus() {
  Serial.print("FRONT -> L:");
  Serial.print(irLeftRaw);
  Serial.print(" R:");
  Serial.print(irRightRaw);
  Serial.print("    REAR:");
  Serial.print(irRearRaw);
  Serial.print("   ");

  if (rearFloorLost) {
    Serial.println("[DEPTH STOP: D33 FLOOR LOST]");
    return;
  }

  Serial.print("[");
  Serial.print(irLineLabel);
  Serial.println("]");
}

void sendLineFollowCommand(const String& command) {
  if (lastLineCommand == command) return;

  lastLineCommand = command;
  sendToArduino("CMD:" + command);
}

void triggerRearSafetyStop() {
  if (rearFloorLost) return;

  rearFloorLost = true;
  irLineState = "DEPTH_STOP";
  irLineLabel = "DEPTH STOP: FLOOR LOST";
  driveModeSource = "DEPTH_ANALYZER";
  lastAutoModeReason = "D33 floor detection lost";
  Serial.println("DEPTH STOP: D33 FLOOR LOST");

  movementDirection = "stop";
  currentSpeed = 0;
  lastLineCommand = "stop";
  obstacleActive = false;
  sendToArduino("CMD:stop");
}

void clearRearSafetyFlagIfRecovered() {
  if (rearFloorLost) {
    Serial.println("DEPTH SAFE: D33 FLOOR RESTORED");
  }
  rearFloorLost = false;
}

void runLineFollowingIfSelected() {
  if (emergencyActive || rearFloorLost) return;

  if (currentDriveMode != "Line Following") {
    lastLineCommand = "stop";
    return;
  }

  if (lineDetected) {
    lastLineSeen = millis();
    driveModeSource = "WEB_COMMAND";
    lastAutoModeReason = "Manual Line Following mode using D5/D26 sensors";

    if (irLineState == "LINE_CENTERED") {
      sendLineFollowCommand("forward");
    }
    else if (irLineState == "LINE_TOWARDS_LEFT") {
      sendLineFollowCommand("left");
    }
    else if (irLineState == "LINE_TOWARDS_RIGHT") {
      sendLineFollowCommand("right");
    }
  }
  else {
    sendLineFollowCommand("stop");
    lastAutoModeReason = "Line Following selected but no black line detected on D5/D26";
  }
}

void readIRSensors() {
  int leftState = digitalRead(IR_LEFT);
  int rightState = digitalRead(IR_RIGHT);
  int rearState = digitalRead(IR_REAR);

  irLeftRaw = leftState;
  irRightRaw = rightState;
  irRearRaw = rearState;

  // Hardware polarity for this setup:
  // D5/D26 detect black line when the sensor output goes HIGH.
  // D33 detects floor/depth present when the sensor output goes HIGH.
  bool leftBlack = (leftState == HIGH);
  bool rightBlack = (rightState == HIGH);
  bool floorPresentNow = (rearState == HIGH);

  if (!floorPresentNow) {
    if (depthLostCounter < DEPTH_LOST_CONFIRM_COUNT) depthLostCounter++;
    depthRestoreCounter = 0;
  } else {
    depthLostCounter = 0;
    if (depthRestoreCounter < DEPTH_LOST_CONFIRM_COUNT) depthRestoreCounter++;
  }

  if (depthLostCounter >= DEPTH_LOST_CONFIRM_COUNT) {
    triggerRearSafetyStop();
    lineDetected = false;
    printIRTestStatus();
    return;
  }

  if (rearFloorLost && depthRestoreCounter >= DEPTH_LOST_CONFIRM_COUNT) {
    clearRearSafetyFlagIfRecovered();
  }

  if (leftBlack && rightBlack) {
    irLineState = "LINE_CENTERED";
    irLineLabel = "LINE CENTERED";
    lineDetected = true;
  }
  else if (leftBlack && !rightBlack) {
    irLineState = "LINE_TOWARDS_LEFT";
    irLineLabel = "LINE TOWARDS LEFT";
    lineDetected = true;
  }
  else if (!leftBlack && rightBlack) {
    irLineState = "LINE_TOWARDS_RIGHT";
    irLineLabel = "LINE TOWARDS RIGHT";
    lineDetected = true;
  }
  else {
    irLineState = "NO_LINE";
    irLineLabel = "NO LINE";
    lineDetected = false;
  }

  printIRTestStatus();
}

void refreshClientContact() {
  lastClientContact = millis();
  clientSessionActive = true;
  clientWatchdogStopped = false;
}

// ================= CORS =================
void addCORS() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.sendHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  server.sendHeader("Access-Control-Allow-Headers", "Content-Type");
}

// ================= SEND TO ARDUINO =================
void sendToArduino(String cmd) {
  arduinoSerial.println(cmd);

  Serial.print("-> ");
  Serial.println(cmd);

  updateDirectionFromCommand(cmd);
}

void stopFromClientWatchdog() {
  if (emergencyActive) return;

  bool chairMoving = normalizeDirection(movementDirection) != "stop" || currentSpeed > 0.01;
  if (!chairMoving || clientWatchdogStopped) return;

  Serial.println("CLIENT TIMEOUT STOP");
  sendToArduino("CMD:stop");
  movementDirection = "stop";
  currentSpeed = 0;
  clientWatchdogStopped = true;
}

// ================= ULTRASONIC =================
float readUltrasonic(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, ULTRASONIC_TIMEOUT_US);

  if (duration == 0) return -1;

  float distance = duration * 0.034 / 2.0;
  if (distance < 0.5 || distance > ULTRASONIC_MAX_VALID_CM) return -1;

  return distance;
}

// ================= OBSTACLE CHECK =================
void checkObstacle() {
  if (rearFloorLost) {
    obstacleConfirmCounter = 0;
    obstacleClearCounter = 0;
    obstacleActive = false;
    frontObstacleDetected = false;
    rearObstacleDetected = false;
    closestFrontObstacleCm = -1;
    closestRearObstacleCm = -1;
    obstacleStopIssued = false;
    return;
  }

  bool frontLeftObs  = isObstacleDistance(distFrontLeft);
  bool frontRightObs = isObstacleDistance(distFrontRight);
  bool backLeftObs   = isObstacleDistance(distBackLeft);
  bool backRightObs  = isObstacleDistance(distBackRight);

  frontObstacleDetected = frontLeftObs || frontRightObs;
  rearObstacleDetected = backLeftObs || backRightObs;
  closestFrontObstacleCm = smallestValidDistance(distFrontLeft, distFrontRight);
  closestRearObstacleCm = smallestValidDistance(distBackLeft, distBackRight);

  bool obstacleNow = frontObstacleDetected || rearObstacleDetected;
  String dir = normalizeDirection(movementDirection);
  bool pathBlockedNow = false;

  if (dir == "forward") {
    pathBlockedNow = frontObstacleDetected;
  }
  else if (dir == "back") {
    pathBlockedNow = rearObstacleDetected;
  }
  else if (dir == "right" || dir == "left") {
    pathBlockedNow = frontObstacleDetected;
  }

  if (obstacleNow) {
    if (obstacleConfirmCounter < OBSTACLE_CONFIRM_COUNT) obstacleConfirmCounter++;
    obstacleClearCounter = 0;
  } else {
    if (obstacleClearCounter < OBSTACLE_CLEAR_COUNT) obstacleClearCounter++;
    if (obstacleClearCounter >= OBSTACLE_CLEAR_COUNT) {
      obstacleConfirmCounter = 0;
    }
  }

  bool obstacleConfirmed = obstacleConfirmCounter >= OBSTACLE_CONFIRM_COUNT;

  if (obstacleConfirmed && pathBlockedNow && !obstacleStopIssued && dir != "stop") {
    Serial.println("OBSTACLE STOP");
    sendToArduino("CMD:stop");
    movementDirection = "stop";
    currentSpeed = 0;
    obstacleStopIssued = true;
  }

  if (!pathBlockedNow || !obstacleConfirmed) {
    obstacleStopIssued = false;
  }

  obstacleActive = obstacleConfirmed;
}

// ================= SENSOR READ =================
void readSensors() {
  distFrontLeft  = -1;
  distFrontRight = -1;
  distBackLeft   = -1;
  distBackRight  = -1;

  String dir = normalizeDirection(movementDirection);

  if (dir == "forward") {
    distFrontLeft  = readUltrasonic(TRIG_FL, ECHO_FL);
    distFrontRight = readUltrasonic(TRIG_FR, ECHO_FR);
  }
  else if (dir == "back") {
    distBackLeft   = readUltrasonic(TRIG_BL, ECHO_BL);
    distBackRight  = readUltrasonic(TRIG_BR, ECHO_BR);
  }
  else if (dir == "right" || dir == "left") {
    distFrontLeft  = readUltrasonic(TRIG_FL, ECHO_FL);
    distFrontRight = readUltrasonic(TRIG_FR, ECHO_FR);
  }
  else {
    distFrontLeft  = readUltrasonic(TRIG_FL, ECHO_FL);
    distFrontRight = readUltrasonic(TRIG_FR, ECHO_FR);
    distBackLeft   = readUltrasonic(TRIG_BL, ECHO_BL);
    distBackRight  = readUltrasonic(TRIG_BR, ECHO_BR);
  }

  checkObstacle();
}

// ================= ENV SENSOR READ =================
void readDHTSensor() {
  float t = dht.readTemperature();
  float h = dht.readHumidity();

  if (!isnan(t)) temperatureC = t;
  if (!isnan(h)) humidity = h;
}

void readMQ3Sensor() {
  mq3Value = analogRead(MQ3_PIN);
}

// ================= PARSE SERIAL =================
void parseArduino(String data) {
  data.trim();
  if (data.length() == 0) return;

  lastArduinoPacketAt = millis();
  motorDriverConnected = true;

  Serial.print("<- ");
  Serial.println(data);

  if (data.startsWith("ANGLE:")) {
    currentAngle = data.substring(6).toFloat();
    lastUpdate = millis();
  }
  else if (data.startsWith("SPEED:")) {
    currentSpeed = data.substring(6).toFloat();
  }
  else if (data.startsWith("DIR:")) {
    movementDirection = normalizeDirection(data.substring(4));
  }
  else if (data == "STOP") {
    currentSpeed = 0;
    movementDirection = "stop";
  }
  else if (data == "SYSTEM_READY") {
    motorDriverConnected = true;
    Serial.println("Arduino Ready");
  }
  else if (data == "READY") {
    motorDriverConnected = true;
    Serial.println("EEG Ready");
  }
  else if (data.startsWith("Blink Count:")) {
    Serial.println(data);
  }
  else if (data.startsWith("MODE:")) {
    currentDriveMode = data.substring(5);
    currentDriveMode.trim();
    Serial.println(data);
  }
  else if (data == "EMERGENCY:ON") {
    emergencyActive = true;
    movementDirection = "stop";
    currentSpeed = 0;
  }
  else if (data == "EMERGENCY:OFF") {
    emergencyActive = false;
    movementDirection = "stop";
    currentSpeed = 0;
  }
  else if (data == "LOCKED") {
    Serial.println("Arduino emergency lock active");
  }
}

// ================= NON-BLOCKING SERIAL READER =================
void processArduinoSerial() {
  while (arduinoSerial.available()) {
    char c = (char)arduinoSerial.read();

    if (c == '\r') continue;

    if (c == '\n') {
      if (serialBuffer.length() > 0) {
        parseArduino(serialBuffer);
        serialBuffer = "";
      }
    }
    else {
      if (serialBuffer.length() < 120) {
        serialBuffer += c;
      } else {
        serialBuffer = "";
      }
    }
  }
}

// ================= ROUTES =================
void handleRoot() {
  refreshClientContact();
  addCORS();
  server.send(200, "text/plain", "ESP32 Bridge Running");
}

void handleCmd() {
  refreshClientContact();
  addCORS();

  if (!server.hasArg("data")) {
    server.send(400, "text/plain", "Missing data");
    return;
  }

  String cmd = server.arg("data");
  cmd.trim();

  if (emergencyActive && cmd != "CMD:stop" && cmd != "CMD:EMERGENCY_OFF") {
    server.send(423, "text/plain", "EMERGENCY_ACTIVE");
    return;
  }

  if (rearFloorLost && cmd != "CMD:stop" && cmd != "CMD:EMERGENCY_OFF") {
    server.send(423, "text/plain", "DEPTH_STOP_ACTIVE");
    return;
  }

  if (cmd.startsWith("MODE:")) {
    currentDriveMode = cmd.substring(5);
    currentDriveMode.trim();
    driveModeSource = "WEB_COMMAND";
    lastAutoModeReason = "Mode changed from dashboard";
    lastLineCommand = "stop";
    movementDirection = "stop";
    currentSpeed = 0;
  }

  sendToArduino(cmd);

  server.send(200, "text/plain", "OK");
}

void handleSpeed() {
  refreshClientContact();
  addCORS();

  if (emergencyActive) {
    server.send(423, "text/plain", "EMERGENCY_ACTIVE");
    return;
  }

  if (rearFloorLost) {
    server.send(423, "text/plain", "DEPTH_STOP_ACTIVE");
    return;
  }

  if (!server.hasArg("speed")) {
    server.send(400, "text/plain", "Missing speed");
    return;
  }

  int percent = server.arg("speed").toInt();
  sendToArduino("CMD:SPEED:" + String(percent));

  server.send(200, "text/plain", "SPEED_SET");
}

void handleAngle() {
  refreshClientContact();
  addCORS();
  server.send(200, "text/plain", String(currentAngle, 1));
}

void handleTelemetry() {
  refreshClientContact();
  addCORS();

  StaticJsonDocument<512> doc;

  doc["angle"] = currentAngle;
  doc["speed"] = currentSpeed;
  doc["emergency"] = emergencyActive;

  doc["FL"] = distFrontLeft;
  doc["FR"] = distFrontRight;
  doc["BL"] = distBackLeft;
  doc["BR"] = distBackRight;

  doc["temp"] = temperatureC;
  doc["humidity"] = humidity;
  doc["mq3"] = mq3Value;

  doc["obstacle"] = obstacleActive;
  doc["front_obstacle_detected"] = frontObstacleDetected;
  doc["rear_obstacle_detected"] = rearObstacleDetected;
  doc["closest_front_cm"] = closestFrontObstacleCm;
  doc["closest_rear_cm"] = closestRearObstacleCm;
  doc["depth_stop"] = rearFloorLost;
  doc["direction"] = movementDirection;
  doc["drive_mode"] = currentDriveMode;
  doc["drive_mode_source"] = driveModeSource;
  doc["drive_mode_reason"] = lastAutoModeReason;
  doc["line_state"] = irLineState;
  doc["line_label"] = irLineLabel;
  doc["line_detected"] = lineDetected;
  doc["ir_left"] = irLeftRaw;
  doc["ir_right"] = irRightRaw;
  doc["ir_rear"] = irRearRaw;
  doc["rear_floor_lost"] = rearFloorLost;
  doc["floor_detected_d33"] = (irRearRaw == HIGH);
  doc["motor_driver_connected"] = isMotorDriverLinkAlive();
  doc["last_update"] = millis() - lastUpdate;

  String res;
  serializeJson(doc, res);

  server.send(200, "application/json", res);
}

void handleEmergency() {
  refreshClientContact();
  addCORS();

  emergencyActive = true;
  sendToArduino("CMD:EMERGENCY_ON");

  server.send(200, "application/json", "{\"status\":\"EMERGENCY_TRIGGERED\"}");
}

void handleResetEmergency() {
  refreshClientContact();
  addCORS();

  emergencyActive = false;
  driveModeSource = "WEB_COMMAND";
  lastAutoModeReason = "Emergency released from dashboard";
  lastLineCommand = "stop";
  sendToArduino("CMD:EMERGENCY_OFF");
  server.send(200, "application/json", "{\"status\":\"RESET\"}");
}

void handlePing() {
  refreshClientContact();
  addCORS();
  server.send(200, "text/plain", "PONG");
}

void handleOptions() {
  refreshClientContact();
  addCORS();
  server.send(204);
}

// ================= SETUP =================
void setup() {
  Serial.begin(115200);
  arduinoSerial.begin(115200, SERIAL_8N1, 16, 17);

  WiFi.setSleep(false);

  dht.begin();
  pinMode(MQ3_PIN, INPUT);

  pinMode(TRIG_FL, OUTPUT);
  pinMode(ECHO_FL, INPUT);

  pinMode(TRIG_FR, OUTPUT);
  pinMode(ECHO_FR, INPUT);

  pinMode(TRIG_BL, OUTPUT);
  pinMode(ECHO_BL, INPUT);

  pinMode(TRIG_BR, OUTPUT);
  pinMode(ECHO_BR, INPUT);

  pinMode(IR_LEFT, INPUT);
  pinMode(IR_RIGHT, INPUT);
  pinMode(IR_REAR, INPUT);

  Serial.println("\nESP32 BRIDGE STARTING...\n");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nCONNECTED");
  Serial.println(WiFi.localIP());
  refreshClientContact();

  server.on("/", HTTP_GET, handleRoot);
  server.on("/cmd", HTTP_GET, handleCmd);
  server.on("/speed", HTTP_GET, handleSpeed);
  server.on("/angle", HTTP_GET, handleAngle);
  server.on("/telemetry", HTTP_GET, handleTelemetry);
  server.on("/emergency", HTTP_GET, handleEmergency);
  server.on("/reset", HTTP_GET, handleResetEmergency);
  server.on("/ping", HTTP_GET, handlePing);

  server.on("/", HTTP_OPTIONS, handleOptions);
  server.on("/cmd", HTTP_OPTIONS, handleOptions);
  server.on("/speed", HTTP_OPTIONS, handleOptions);
  server.on("/angle", HTTP_OPTIONS, handleOptions);
  server.on("/telemetry", HTTP_OPTIONS, handleOptions);
  server.on("/emergency", HTTP_OPTIONS, handleOptions);
  server.on("/reset", HTTP_OPTIONS, handleOptions);
  server.on("/ping", HTTP_OPTIONS, handleOptions);

  server.begin();
}

// ================= LOOP =================
void loop() {
  processArduinoSerial();
  server.handleClient();

  unsigned long now = millis();

  if (now - lastUltrasonicRead >= ULTRASONIC_INTERVAL) {
    lastUltrasonicRead = now;
    readSensors();
  }

  if (now - lastIrRead >= IR_INTERVAL) {
    lastIrRead = now;
    readIRSensors();
    runLineFollowingIfSelected();
  }

  if (now - lastMq3Read >= MQ3_INTERVAL) {
    lastMq3Read = now;
    readMQ3Sensor();
  }

  if (now - lastDhtRead >= DHT_INTERVAL) {
    lastDhtRead = now;
    readDHTSensor();
  }

  if (now - lastWifiCheck >= WIFI_CHECK_INTERVAL) {
    lastWifiCheck = now;

    if (WiFi.status() != WL_CONNECTED) {
      Serial.println("Reconnecting WiFi...");
      WiFi.reconnect();
    }
  }

  if (clientSessionActive && now - lastClientContact >= CLIENT_WATCHDOG_TIMEOUT) {
    stopFromClientWatchdog();
  }

  processArduinoSerial();
  delay(2);
}
